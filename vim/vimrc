def g:ToggleMarkdownListItem(): void
    var cursor_line = line('.')
    var line_text = getline(cursor_line)

    if line_text =~ '^\s*\([-*]\|[0-9]\+\.\)\s\+'
        var new_line: string

        if line_text =~ '^\s*\([-*]\|[0-9]\+\.\)\s\+\~\~.*\~\~$'
            new_line = substitute(
                           line_text,
                           '^\(\s*\([-*]\|[0-9]\+\.\)\)\s\+\~\~\(.*\)\~\~$',
                           '\1 \3',
                           ''
                       )
        else
            new_line = substitute(
                           line_text,
                           '^\(\s*\([-*]\|[0-9]\+\.\)\)\s\+\(.*\)$',
                           '\1 ~~\3~~',
                           ''
                       )
        endif

        setline(cursor_line, new_line)
    endif
    return
enddef
