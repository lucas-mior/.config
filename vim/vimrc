def g:JumpToNextFileWithDiag()
    var current_file: string = expand('%:p')
    var c_files: list<string> = glob('src/*.c', false, true)
  
    if empty(c_files)
        return
    endif

    var absolute_files: list<string> = []
    for f in c_files
        var abs_path: string = fnamemodify(f, ':p')
        add(absolute_files, abs_path)
    endfor

    var current_idx: number = index(absolute_files, current_file)
    var start_idx: number = 0
    if current_idx != -1
        start_idx = current_idx
    endif

    var num_files: number = len(absolute_files)
  
    for i in range(1, num_files)
        var idx: number = (start_idx + i) % num_files
        var target: string = absolute_files[idx]
      
        execute 'hide edit ' .. target
      
        var placed: list<dict<any>> = sign_getplaced('', {group: '*'})
        var signs: list<dict<any>> = placed[0].signs
      
        if !empty(signs)
            try
                execute 'LspDiagNextWrap'
                return
            catch
                # If LspDiagNextWrap fails (e.g., signs are not from LSP), 
                # ignore the error and let the loop continue to the next file
            endtry
        endif
    endfor
  
    return
enddef

