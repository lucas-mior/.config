def g:SwitchOrFzf(): void
    var bufs = filter(range(1, bufnr('$')), (_, v) => buflisted(v))
    var ntabs = tabpagenr('$')

    if ntabs > 1
        execute 'normal gt'
        return
    endif

    if len(bufs) == 1
        g:FzfFindFile()
    elseif len(bufs) == 2
       var alt_buf = bufnr('#')
       execute 'buffer ' .. alt_buf
    else
        g:FzfFindFile()
    endif
enddef

def RightAlign(char: string)
    if strlen(char) > 1
        return
    endif

    var linelength: number = strlen(getline('.'))
    right
    var spaces: number = strlen(getline('.')) - linelength

    execute "normal 0|d" .. spaces .. "l"
    execute "normal f" .. char
    normal P

    return
enddef

command! -range -nargs=1 RightAlign :<line1>,<line2>call RightAlign(<args>)

def CopyFileWithHeader(is_visual: bool)
    var filename: string = expand('%:t')
    var header: string = ""
    var body: string = ""

    if is_visual
        header = $"some parts of {filename}:\n"
        var region = getregion(getpos("'<"), getpos("'>"))
        body = join(region, "\n")
    else
        header = $"{filename}:\n"
        var lines = getline(1, '$')

        if &filetype == 'c'
            var filtered: list<string> = []
            var skipping_comments = true

            for line in lines
                if skipping_comments
                    if line =~ '^\s*\(//\|/\*\|\s*\*\|\s*$\)'
                        continue
                    endif
                    skipping_comments = false
                endif

                if line =~ '^#if TESTING'
                    add(filtered, "// skipping #if TESTING block for brevity...")
                    break
                endif

                add(filtered, line)
            endfor
            body = join(filtered, "\n")
        else
            body = join(lines, "\n")
        endif
    endif

    setreg('+', header .. body)
    echomsg "Copied to clipboard with header."
enddef

nnoremap <silent> <leader>fc <ScriptCmd>CopyFileWithHeader(false)<CR>
xnoremap <silent> <leader>fc <ScriptCmd>CopyFileWithHeader(true)<CR>

