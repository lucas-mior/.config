def g:FzfFindFile(): void
    var buflist = []
    for buf in range(1, bufnr('$'))
        add(buflist, bufname(buf))
    endfor
    writefile(buflist, '/tmp/vimbuflist')

    var cmd =
           ' { /usr/bin/cat /tmp/vimbuflist;         '
        .. '   rg --files --no-messages;             '
        .. '   find .git/hooks -type f 2>/dev/null; }'
        .. '   | sed "s|^./||g"'
        .. '   | sort | uniq'
        .. '   | fzf --bind one:accept 2>/dev/null'

    var file = trim(system(cmd))

    delete('/tmp/vimbuflist')

    if file ==# ''
        redraw!
        return
    endif

    sleep 100m
    while getchar(0) != 0
        # wait until there are no chars to read
    endwhile

    execute 'edit ' .. fnameescape(file)
    redraw!
    return
enddef

nnoremap <C-f> :call g:FzfFindFile()<CR>

def g:FzfFindRegex(): void
    var preview_script = 'fzf_bat_preview.bash'

    # Add your exclusions here using -g '!pattern'
    # For example, excluding .git, binaries, and common TeX junk
    var cmd =
        'rg --line-number --no-heading'
        .. ' -g "!.git/*"'
        .. ' -g "!*.{o,bin,exe}"'
        .. ' -g "!*.{pdf,log,aux,bbl,blg,toc}"'
        .. ' -g "!package/{pkg,src}"'
        .. ' -g "!node_modules/*"'
        .. ' . 2>/dev/null'
        .. ' | fzf --delimiter ":"'
        .. '       --bind one:accept'
        .. '       --preview-window=up,80%,border-rounded'
        .. '       --preview "' .. preview_script .. ' {1} {2}"'

    var out = systemlist(cmd)

    while getchar(0) != 0
    endwhile
    redraw!

    if empty(out) || out[0] ==# ''
        return
    endif

    var parts = split(out[0], ':', v:false)
    if len(parts) < 2
        return
    endif

    var file_path = parts[0]
    var line_num = str2nr(parts[1])

    if filereadable(file_path)
        execute 'edit ' .. fnameescape(file_path)
        execute ':' .. line_num
        normal! zz
    endif

    redraw!
    return
enddef

nnoremap <C-h> :call g:FzfFindRegex()<CR>

